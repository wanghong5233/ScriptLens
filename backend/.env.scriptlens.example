# ============================================================
# ScriptLens production env example（叠加到 ScholarMind 已有 .env.production）
#
# 部署位置：与 ScriptLens compose 文件同目录，复制为 .env.scriptlens 后填值
#   cp .env.scriptlens.example .env.scriptlens
#
# 凡是 ScholarMind .env.production 已经定义的变量（POSTGRES_PASSWORD /
# DASHSCOPE_API_KEY / JWT_SECRET_KEY / OPENAI_* 等），ScriptLens 容器通过
# compose 的 environment / 环境变量继承，**不要在此重复**。本文件只列
# ScriptLens 专属或必须 override 的变量。
# ============================================================

# -----------------------------
# ScriptLens 专属
# -----------------------------
# 剧本原始文件持久化目录（ECS 宿主机路径，需先 mkdir 并赋权）
#   sudo mkdir -p /opt/data/scriptlens/storage
#   sudo chown -R $USER:$USER /opt/data/scriptlens
SCRIPTLENS_STORAGE_ROOT=/opt/data/scriptlens/storage

# Redis db 号（与 ScholarMind 的 0 号库隔离）
SCRIPTLENS_REDIS_DB=1

# DATABASE_URL：默认继承 ScholarMind PG 连接串；如果想改密码或改库名再覆盖
# SCRIPTLENS_DATABASE_URL=postgresql://postgres:CHANGE_ME@scholarmind_db:5432/scholarmind

# -----------------------------
# JWT / Demo（可与 ScholarMind 共用同一份；建议生产期沿用同密钥保证 SSO 体验）
# -----------------------------
# JWT_SECRET_KEY=  # 留空则继承 ScholarMind .env.production 同名变量

# -----------------------------
# 公网域名（CF Zero Trust 配置 hostname）
# -----------------------------
# 在 Cloudflare Zero Trust 控制台为已有 tunnel `cf_tunnel_scholarmind` 加一条
# public hostname：
#   api-scriptlens.wh5233.me  →  http://scriptlens_api:8005
# 不需要在此文件配置（属于 CF 控制台行为）。
SCRIPTLENS_PUBLIC_API=https://api-scriptlens.wh5233.me

# -----------------------------
# 上传限制
# -----------------------------
MAX_UPLOAD_SIZE_MB=80
