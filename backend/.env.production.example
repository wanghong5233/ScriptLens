# ============================================================
# ScriptLens 生产 env 模板
#
# 用法：
#   cp .env.production.example .env.production
#   编辑后填入所有 <CHANGE_ME>
#
# 不变式（违反即视为部署事故）：
#   1. 本文件不进 git（已被 .gitignore 排除）
#   2. JWT_SECRET_KEY 必须是 32 字节随机串：python -c "import secrets; print(secrets.token_hex(32))"
#   3. 远程解析优先（llamaparse / unstructured_api），不在容器里跑本地大模型 / OCR
#   4. CF_TUNNEL_TOKEN 来自 Cloudflare Zero Trust 控制台为本项目新建的独立 tunnel
# ============================================================

# ============================================================
# Section 1: 数据库 / Redis
# ============================================================
# scriptlens_db 容器初始化时会用这三个变量创建 PG 实例
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME_RANDOM>
POSTGRES_DB=scriptlens

# ============================================================
# Section 2: 文件落盘
# ============================================================
# 部署前先 mkdir -p /opt/data/scriptlens/storage 并 chown 给当前用户
SCRIPTLENS_STORAGE_ROOT=/opt/data/scriptlens/storage

# ============================================================
# Section 3: 公网入口（Cloudflare Tunnel，独立 token）
# ============================================================
# Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel
#   1. tunnel name: scriptlens-prod
#   2. 复制 docker run 命令里的 --token 值，填到下面
#   3. Public Hostnames → Add：
#         api-scriptlens.wh5233.me  →  http://scriptlens_api:8005
CF_TUNNEL_TOKEN=<CHANGE_ME>

# ============================================================
# Section 4: LLM 推理（OpenAI 主，DashScope 兜底）
# ============================================================
OPENAI_API_KEY=<CHANGE_ME>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-5.2
SM_LLM_TYPE=openai

# ============================================================
# Section 5: Embedding / Reranker（DashScope 唯一）
# ============================================================
DASHSCOPE_API_KEY=<CHANGE_ME>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen3-max-latest
DASHSCOPE_MODEL_CANDIDATES=qwen3-max-latest,qwen-max-latest,qwen-max,qwen3-max
SM_DASHSCOPE_RERANK_MODEL=qwen3-rerank
SM_EMBEDDING_MODEL=text-embedding-v3
SM_EMBEDDING_DIMENSIONS=1024
SM_EMBEDDING_ENCODING_FORMAT=float
SM_EMBEDDING_MAX_BATCH_SIZE=10

# ============================================================
# Section 6: 远程文档解析（DOCX / PDF）
# ============================================================
SM_PARSER_ORDER=llamaparse,unstructured_api,pymupdf
SM_REMOTE_PARSER_STRICT_FAIL=true
SM_REMOTE_PARSER_REQUIRE_PAGE=true
SM_REMOTE_PARSER_REQUIRE_BBOX=false
SM_UNSTRUCTURED_API_KEY=<CHANGE_ME>
SM_UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general
SM_UNSTRUCTURED_STRATEGY=hi_res
SM_UNSTRUCTURED_TIMEOUT_SECS=180
SM_LLAMA_PARSE_API_KEY=<CHANGE_ME>
SM_LLAMA_PARSE_BASE_URL=https://api.cloud.llamaindex.ai
SM_LLAMA_PARSE_TIMEOUT_SECS=120
SM_LLAMA_PARSE_POLL_INTERVAL_SECS=2
SM_LLAMA_PARSE_MAX_POLL_ATTEMPTS=60

# ============================================================
# Section 7: 安全 / Demo / CORS
# ============================================================
JWT_SECRET_KEY=<CHANGE_ME_64_HEX>

SM_DEMO_MODE=false
SM_DEMO_ENTRY_ENABLED=true
SM_DEMO_USERNAME=testuser
SM_DEMO_TOKEN_EXPIRE_HOURS=24
SM_ASK_RATE_LIMIT_PER_MINUTE=60

# 只写 origin，不写 path。Vercel 上线后立即同步真实域名
SM_CORS_ALLOW_ORIGINS=https://scriptlens.wh5233.me,https://scriptlens.vercel.app

# ============================================================
# Section 8: Agent 联网搜索（Tavily，可留空降级）
# ============================================================
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=<CHANGE_ME_OR_BLANK>
TAVILY_API_KEY=<SAME_AS_ABOVE>
WEB_SEARCH_BASE_URL=https://api.tavily.com/search
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=20

# ============================================================
# Section 9: Agent / 严格模式 / 上传 / 日志
# ============================================================
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT=180
STRICT_FAIL_FAST=true
MAX_UPLOAD_SIZE_MB=80
LOG_LEVEL=INFO

# ============================================================
# Section 10: 不需要的功能（留空 = 自动跳过；不要删，避免 settings.* 缺字段报错）
# ============================================================
SEMANTIC_SCHOLAR_API_KEY=
