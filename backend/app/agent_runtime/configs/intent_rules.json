{
  "version": "scriptlens-1.0",
  "_doc": [
    "ScriptLens 短剧场景的意图分类规则：",
    "  qa     —— 默认意图（短剧问答、场景定位、维度追问、人物清单、市场查询）",
    "  suggest—— 评估 / 建议 / 选品判断",
    "  edit   —— 改写场景（propose_rewrite_tool）",
    "  citation/file_op —— schema 占位，短剧不会命中",
    "fallback 改为 qa（不再像 doc_studio 那样 fallback 到 edit，避免误触改写流程）。"
  ],
  "rules": [
    {
      "intent": "qa",
      "description": "短剧问答、场景定位、维度解释、人物清单、市场 / 法规查询",
      "keywords": [
        "什么",
        "为什么",
        "怎么",
        "如何",
        "哪一",
        "哪几",
        "哪个",
        "在哪",
        "钩子",
        "反转",
        "爽点",
        "高潮",
        "节奏",
        "动机",
        "风险",
        "审核",
        "主角",
        "男主",
        "女主",
        "男配",
        "女配",
        "解释",
        "说明",
        "看看",
        "？",
        "?"
      ],
      "patterns": [
        ".*是什么.*",
        ".*什么意思.*",
        ".*为什么.*",
        ".*哪.*集.*",
        ".*哪.*场.*",
        ".*第\\d+集.*",
        ".*第\\d+场.*",
        ".*\\?$",
        ".*？$"
      ],
      "examples": [
        "前 5 集的钩子在哪？",
        "为什么人物力给 4 分？",
        "这剧主角是谁？",
        "这种甜宠最近抖音同类型表现如何？"
      ]
    },
    {
      "intent": "suggest",
      "description": "选品判断 / 改稿建议 / 风险评估",
      "keywords": [
        "建议",
        "推荐",
        "值得",
        "签不签",
        "要不要",
        "评估",
        "判断",
        "review",
        "evaluate"
      ],
      "patterns": [
        ".*值得.*签.*",
        ".*要不要.*",
        ".*建议.*",
        ".*推荐.*"
      ],
      "examples": [
        "这本剧值得签吗？",
        "给点改稿建议",
        "评估一下风险"
      ]
    },
    {
      "intent": "edit",
      "description": "用户明确要求改写某场剧本",
      "keywords": [
        "改写",
        "重写",
        "改紧凑",
        "改",
        "rewrite",
        "优化这场",
        "优化场景",
        "提升",
        "调整动机",
        "调整节奏"
      ],
      "patterns": [
        ".*改写.*场.*",
        ".*重写.*场.*",
        ".*第\\d+场.*改.*",
        ".*把.*场.*改.*",
        ".*优化.*场.*"
      ],
      "examples": [
        "把第 5 场改紧凑",
        "这场动机不成立帮我改",
        "重写第 3 集第 2 场"
      ]
    },
    {
      "intent": "citation",
      "description": "短剧场景占位（无引用语义，理论上不会命中）",
      "keywords": [],
      "patterns": [],
      "examples": []
    },
    {
      "intent": "file_op",
      "description": "短剧场景占位（无文件操作语义，理论上不会命中）",
      "keywords": [],
      "patterns": [],
      "examples": []
    }
  ],
  "fallback": {
    "intent": "qa",
    "reason": "短剧场景下绝大多数请求是问答 / 定位 / 维度追问；低置信度默认走 qa，让 LLM 在 ReAct 循环里看 system prompt 自由决策"
  }
}
