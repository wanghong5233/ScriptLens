# ============================================================
# ScriptLens 本地开发 env 模板
#
# 用法：
#   cp .env.dev.example .env.dev
#   编辑 .env.dev 填入两个 key（见下方）
#   docker compose -f docker-compose.dev.yml up -d
#
# 注意：DATABASE_URL / REDIS_* / SM_VECTOR_STORE 等已在 compose 文件里
# 由 environment 块写死，不需要在此声明。本文件只放「需要密钥/可调」的变量。
# ============================================================

# ============================================================
# Section 1: LLM 推理（评分 / 决策 / 改写 / 对话）—— 优先 GPT
# ============================================================
# 【必填】OpenAI（主：5 维评分 / Agent 决策 / 改写 / 对话生成）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-5.2

# ============================================================
# Section 2: Embedding —— DashScope（不切换）
# ============================================================
# 【必填】DashScope（embedding 走这里 + LLM 兜底）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen3-max-latest
DASHSCOPE_MODEL_CANDIDATES=qwen3-max-latest,qwen-max-latest,qwen-max,qwen3-max
SM_DASHSCOPE_RERANK_MODEL=qwen3-rerank

# ============================================================
# Section 3: 安全
# ============================================================
# 【必填】JWT 签名密钥（dev 任意字符串）
#   生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev_only_secret_change_me_in_prod

# ============================================================
# Section 4: Demo 模式（本地 dev 开启便于无登录快速调试）
# ============================================================
SM_DEMO_MODE=true
SM_DEMO_ENTRY_ENABLED=true
SM_DEMO_USERNAME=testuser
SM_DEMO_TOKEN_EXPIRE_HOURS=24

# ============================================================
# Section 5: CORS（本地前端 dev server 默认 5173）
# ============================================================
SM_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Section 6: 上传限制
# ============================================================
MAX_UPLOAD_SIZE_MB=80

# ============================================================
# Section 7: Agent 联网搜索（task §六 "真正可工作的 Agent" 加分项）
# ============================================================
# 【强烈建议填】Tavily（短剧选品/编剧/审核/改写场景需要联网拉市场/法规/同类爆款数据）
#   注册：https://tavily.com  → Free tier 1000 次/月，足够 demo
#   留空时：Agent 工具调用返回 skipped，并在终答声明"网络信息暂不可用"，不崩
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_BASE_URL=https://api.tavily.com/search
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=20
ENABLE_WEB_SEARCH=true

# ============================================================
# Section 8: 不需要的功能（留空 = 自动跳过）
# ============================================================
SEMANTIC_SCHOLAR_API_KEY=
SM_LLAMA_PARSE_API_KEY=
SM_UNSTRUCTURED_API_KEY=
