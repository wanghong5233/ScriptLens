# ScriptLens 前端 - 生产环境（Vercel）
#
# 在 Vercel Project Settings → Environment Variables 里逐项填入。
# 不要把真实密钥提交到 git；本文件只是模板。
#
# 不变式：
#   1. VITE_API_BASE 必须带 /api 后缀，与 backend FastAPI 路由前缀对齐
#   2. 后端 hostname 由 ScriptLens 自己的 Cloudflare Tunnel (scriptlens-prod) 暴露
#   3. CORS origin 必须与后端 .env.production 的 SM_CORS_ALLOW_ORIGINS 完全一致

VITE_TITLE=ScriptLens

# 后端公网域名（来自 Cloudflare Tunnel 配置）
VITE_API_BASE=https://api-scriptlens.wh5233.me/api

# Demo 入口（与后端 SM_DEMO_ENTRY_ENABLED / SM_DEMO_USERNAME 对齐）
VITE_DEMO_ENTRY_ENABLED=true
VITE_DEMO_USERNAME=testuser

# 火山引擎语音识别（Recorder 组件用；留空则禁用录音功能）
# 申请入口：https://console.volcengine.com/speech/app
VITE_VOLC_APPID=
VITE_VOLC_ACCESS_KEY=
